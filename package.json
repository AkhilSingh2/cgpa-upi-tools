{
  "name": "hundredmark",
  "private": true,
  "version": "1.0.0",
  "description": "Static CGPA-to-percentage calculator and client-side UPI QR code generator.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/fix-og.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "NEXT_PUBLIC_BASE_PATH=/cgpa-upi-tools NEXT_PUBLIC_SITE_URL=https://example.github.io npm run build && node scripts/prepare-e2e.mjs && playwright test"
  },
  "dependencies": {
    "@sutra-ui/react": "file:vendor/sutra-ui/react",
    "@sutra-ui/tokens": "file:vendor/sutra-ui/tokens",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^26.6.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
